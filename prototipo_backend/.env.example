HOST=0.0.0.0
PORT=3000

# Enable PostgreSQL as the primary structured persistence layer.
NUTRITRACK_USE_POSTGRES=1

# Replace user, password, host, port and database with your local values.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/nutritrack

# Demo user used by the temporary hybrid mirror until auth is implemented.
NUTRITRACK_DEMO_USER_EMAIL=demo@nutritrack.local

# Optional: Strava integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_SCOPES=read,activity:read_all
