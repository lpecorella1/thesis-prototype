HOST=127.0.0.1
PORT=3000
NUTRITRACK_BASE_PATH=/nutritrack
NUTRITRACK_PUBLIC_URL=https://mercurio.isti.cnr.it/nutritrack/

# Azure OpenAI configuration for recipe generation and AI chat.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Enable PostgreSQL as the primary structured persistence layer.
NUTRITRACK_USE_POSTGRES=1

# Replace user, password, host, port and database with your local values.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/nutritrack

# Local implicit identity used only when NUTRITRACK_APP_MODE=single-user-local.
NUTRITRACK_LOCAL_USER_EMAIL=app-local@nutritrack.local

# Runtime mode:
# - authenticated-user enables login/register and per-user persistence through PostgreSQL.
# - single-user-local keeps the prototype open with the local implicit user for explicit local checks.
NUTRITRACK_APP_MODE=authenticated-user

# Optional development-only seed/bootstrap behavior.
NUTRITRACK_ENABLE_DEVELOPMENT_SEED=0

# Optional override for file-based local state, useful for isolated smoke tests.
NUTRITRACK_DATA_DIR=

NUTRITRACK_SESSION_TTL_DAYS=14

# Gmail SMTP for real password reset emails.
# Use a Google App Password, not the normal account password.
NUTRITRACK_SMTP_HOST=smtp.gmail.com
NUTRITRACK_SMTP_PORT=587
NUTRITRACK_SMTP_SECURE=0
NUTRITRACK_SMTP_USER=nutritrack.isti@gmail.com
NUTRITRACK_SMTP_PASS=
NUTRITRACK_MAIL_FROM=NutriTrack <nutritrack.isti@gmail.com>

# Scale provider selection. Supported now: mock
SCALE_PROVIDER=mock
